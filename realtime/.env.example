# Realtime Ludo server. Placeholders only: copy to realtime/.env (never commit it).

# Port to listen on. Most hosts (Render, Railway, Fly) inject PORT themselves.
PORT=4001

# Comma-separated browser origins allowed to connect, with no trailing slash.
# Required in production. Example: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

NODE_ENV=development
