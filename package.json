{
  "name": "media-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Private personal media management app — Next.js frontend + Express/MongoDB backend.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "typecheck:frontend": "npm run typecheck --workspace frontend",
    "typecheck:backend": "npm run typecheck --workspace backend",
    "create-admin": "npm run create-admin --workspace backend",
    "migrate-to-users": "npm run migrate-to-users --workspace backend",
    "migrate-to-atlas": "npm run migrate-to-atlas --workspace backend",
    "migrate-storage": "npm run migrate-storage --workspace backend",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "npm run build:backend && npm run typecheck:backend && npm run typecheck:frontend",
    "test": "npm run test --workspace backend",
    "smoke": "npm run smoke:vercel --workspace backend",
    "lint": "npm run lint --workspace frontend"
  }
}
