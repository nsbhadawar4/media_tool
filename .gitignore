# media_tool — root gitignore
# This is an npm workspaces monorepo: `npm install` at the root installs both
# frontend/ and backend/, and root/package-lock.json is the single lockfile to commit.
# frontend/ and backend/ each also maintain their own .gitignore for their toolchains.

node_modules/

.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
