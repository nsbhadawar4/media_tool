{
  "name": "media-tool-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Private personal media management API (Express + TypeScript + MongoDB)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:trash": "tsx --test tests/trashSafety.test.ts",
    "test:trash-api": "tsx --test tests/trashApi.test.ts",
    "test": "tsx --test tests/trashSafety.test.ts tests/trashApi.test.ts tests/userIsolation.test.ts tests/directUpload.test.ts tests/vercelBridge.test.ts tests/r2Storage.test.ts tests/s3Storage.test.ts tests/storageSelection.test.ts tests/gridfsStorage.test.ts tests/uploadLimits.test.ts tests/bucketDelete.test.ts tests/mediaUrls.test.ts tests/migrateStorage.test.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "migrate-to-users": "tsx src/scripts/migrate-to-users.ts",
    "migrate-to-atlas": "tsx src/scripts/migrate-to-atlas.ts",
    "migrate-storage": "tsx src/scripts/migrate-storage.ts",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "generate-thumbnails": "tsx src/scripts/generate-thumbnails.ts",
    "smoke:vercel": "tsx smoke-vercel.mts",
    "test:isolation": "tsx --test tests/userIsolation.test.ts",
    "test:bridge": "tsx --test tests/vercelBridge.test.ts",
    "test:upload": "tsx --test tests/directUpload.test.ts",
    "test:r2": "tsx --test tests/r2Storage.test.ts",
    "test:storage": "tsx --test tests/r2Storage.test.ts tests/s3Storage.test.ts tests/storageSelection.test.ts tests/gridfsStorage.test.ts tests/gridfsStorage.test.ts tests/uploadLimits.test.ts tests/bucketDelete.test.ts tests/mediaUrls.test.ts tests/migrateStorage.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "types": "dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./database": {
      "types": "./dist/config/database.d.ts",
      "default": "./dist/config/database.js"
    },
    "./env": {
      "types": "./dist/config/env.d.ts",
      "default": "./dist/config/env.js"
    }
  }
}
