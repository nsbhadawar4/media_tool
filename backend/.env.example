# ----------------------------------------------------------------------------
# media_tool - backend environment
# Copy to `.env` and fill in. NEVER commit the real .env file.
#
# On Vercel these are set as Project Environment Variables instead, and this file
# is not deployed. See DEPLOYMENT.md for which of them production actually needs.
# ----------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Origin that media URLs are built against.
# Leave EMPTY in production: frontend and API share one Vercel domain, so relative
# `/api/...` URLs are correct and survive preview deployments, which each get their
# own hostname. Vercel already defaults this to empty; set it only to override.
API_BASE_URL=http://localhost:5000

# Browser origin(s) allowed to call this API, comma-separated. Only consulted when
# API_BASE_URL is non-empty — same-origin deployments negotiate no CORS at all.
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string. Required - the server will not start without it.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/media_tool?retryWrites=true&w=majority
# URL-encode any @ : / ? # % in the password (@ becomes %40).
MONGODB_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used by: npm run create-admin
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Where uploaded files are kept: local | gridfs | r2 | s3
#
#   local   Development default. Writes under UPLOAD_DIR. Refused on a serverless host,
#           where the filesystem is read-only and does not survive the instance.
#   gridfs  In MongoDB itself, using the connection above. Nothing else to configure, and
#           it works on a serverless host - but every byte goes through the API, so files
#           are capped at ~4.4 MB there, and they count against the database's storage.
#   r2/s3   Object storage. What production should use: the browser uploads straight to
#           the bucket, so there is no size cap and the database stays small.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# ----------------------------------------------------------------------------
# Optional - every value below has a working default in src/config/env.ts.
# Uncomment only what you need to override.
# ----------------------------------------------------------------------------
# JWT_EXPIRES_IN=7d
# MEDIA_TOKEN_EXPIRES_IN=2h
# UPLOAD_TOKEN_EXPIRES_IN=30m
# COOKIE_NAME=mt_session
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=                # defaults to true in production and on Vercel
# COOKIE_DOMAIN=
# ADMIN_PASSWORD_HASH=          # use instead of ADMIN_PASSWORD to keep plaintext out of this file
# MAX_FILES_PER_UPLOAD=25
# LOGIN_RATE_LIMIT_WINDOW_MIN=15
# LOGIN_RATE_LIMIT_MAX=10
#
# Number of trusted proxy hops for X-Forwarded-For, which decides the address the rate
# limiters count against. Defaults to 1 on Vercel (exactly one hop) and to none locally.
# Raising it above the real number of proxies lets callers forge the header.
# TRUST_PROXY=
#
# ----------------------------------------------------------------------------
# Object storage. REQUIRED IN PRODUCTION - see DEPLOYMENT.md.
#
# A serverless filesystem is ephemeral, so STORAGE_PROVIDER=local on Vercel would
# lose every uploaded file. Setting r2 or s3 also switches uploads to presigned
# direct-to-bucket transfers, which is what allows files larger than the platform's
# 4.5 MB request body limit to be uploaded at all.
# ----------------------------------------------------------------------------
#
# Cloudflare R2 - what production uses. These five names are exactly what the app reads;
# nothing else is consulted. On Vercel they are set as Project Environment Variables, not
# in a file, which is why they are commented out here - uncommenting them would switch
# local development to R2 as well.
#
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
#
# The first four are required. R2_PUBLIC_BASE_URL is optional and should be LEFT UNSET
# unless the bucket is deliberately public behind a custom domain: with no value the app
# has no direct link to give out, so every file is served through this API's ownership
# check using short-lived presigned URLs, and the bucket stays private.
#
# Never put real values in this file. It is committed; .env is not.
#
# Amazon S3 (set STORAGE_PROVIDER=s3)
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
