# ----------------------------------------------------------------------------
# media_tool — backend environment
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ----------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Public URL of this API (used for building absolute media links)
API_BASE_URL=http://localhost:4000

# ---- Database --------------------------------------------------------------
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/media_tool?retryWrites=true&w=majority
# Local MongoDB:  mongodb://127.0.0.1:27017/media_tool
MONGODB_URI=mongodb://127.0.0.1:27017/media_tool

# ---- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Short-lived token used by <img>/<video> tags to stream private files
MEDIA_TOKEN_EXPIRES_IN=2h

# Cookie behaviour. `lax` works when frontend + backend share a site (localhost).
# Use `none` (requires COOKIE_SECURE=true + HTTPS) when they are on different domains.
COOKIE_NAME=mt_session
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Optional: set only if you need a shared parent domain, e.g. .example.com
COOKIE_DOMAIN=

# ---- Seed / bootstrap admin ------------------------------------------------
# Used by `npm run create-admin`. Provide ADMIN_PASSWORD *or* ADMIN_PASSWORD_HASH.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# ---- Storage ---------------------------------------------------------------
# One of: local | r2 | s3
STORAGE_PROVIDER=local

# local provider
LOCAL_STORAGE_DIR=./uploads

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom domain bound to the bucket
R2_PUBLIC_BASE_URL=

# Amazon S3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: custom endpoint for S3-compatible services (MinIO, Wasabi, ...)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---- Upload limits ---------------------------------------------------------
# Per-file maximum, in megabytes
MAX_FILE_SIZE_MB=512
# Maximum number of files accepted in a single upload request
MAX_FILES_PER_UPLOAD=25

# ---- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=10
