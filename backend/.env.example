# ----------------------------------------------------------------------------
# media_tool - backend environment
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ----------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string. Required - the server will not start without it.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/media_tool?retryWrites=true&w=majority
# URL-encode any @ : / ? # % in the password (@ becomes %40).
MONGODB_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used by: npm run create-admin
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# ----------------------------------------------------------------------------
# Optional - every value below has a working default in src/config/env.ts.
# Uncomment only what you need to override.
# ----------------------------------------------------------------------------
# JWT_EXPIRES_IN=7d
# MEDIA_TOKEN_EXPIRES_IN=2h
# COOKIE_NAME=mt_session
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# ADMIN_PASSWORD_HASH=          # use instead of ADMIN_PASSWORD to keep plaintext out of this file
# MAX_FILES_PER_UPLOAD=25
# LOGIN_RATE_LIMIT_WINDOW_MIN=15
# LOGIN_RATE_LIMIT_MAX=10
#
# Cloudflare R2 (set STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
#
# Amazon S3 (set STORAGE_PROVIDER=s3)
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
