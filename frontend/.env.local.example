# Copy to .env.local for local development.
# Only NEXT_PUBLIC_* values belong here — they are shipped to the browser.
# Never put MONGODB_URI, JWT_SECRET or storage credentials in this file.

# Base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Must match backend's COOKIE_NAME — used only by /admin's server component for a fast
# "is a session cookie present" redirect check. The backend remains the
# sole authority on whether that cookie is actually valid.
NEXT_PUBLIC_SESSION_COOKIE_NAME=mt_session
