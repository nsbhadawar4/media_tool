# Copy to .env.local for local development.
# Only NEXT_PUBLIC_* values belong here — they are shipped to the browser.
# Never put MONGODB_URI, JWT_SECRET or storage credentials in this file.
#
# One exception: `vercel env pull` writes the backend's own variables here, because
# `vercel dev` runs the API inside Next.js and reads them from this directory. That is
# fine — .env.local is gitignored — but it is the only reason they belong in this file.
# For ordinary local development the backend reads backend/.env instead.
# See DEPLOYMENT.md §7.

# Origin of the backend API.
#
# Needed only in development, where the API runs on its own port. In production the
# frontend and the API are one Vercel deployment on one domain, so the client falls
# back to same-origin `/api/...` when this is unset — which is also the only value
# that works on preview deployments, since each gets a different hostname.
#
# Do NOT set this in the Vercel project unless the API is genuinely hosted elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Must match backend's COOKIE_NAME — used only by /admin's server component and by
# proxy.ts for a fast "is a session cookie present" redirect check. The backend
# remains the sole authority on whether that cookie is actually valid.
NEXT_PUBLIC_SESSION_COOKIE_NAME=mt_session
